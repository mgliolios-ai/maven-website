---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../site';

interface Props {
  title: string;
  description: string;
  /** Omit the sticky nav (unused for now, kept for campaign pages). */
  bare?: boolean;
  /** Link preview image, as a path on this site. Blog posts set this. */
  image?: string;
  imageAlt?: string;
  /** Set on blog posts, so they're shared as articles with their dates. */
  article?: { published: Date; modified?: Date };
}

const { title, description, bare = false, image, imageAlt, article } = Astro.props;

const fullTitle = title === 'Marlo' ? 'Marlo. Your body. Finally understood.' : `${title} · Marlo.`;
const site = Astro.site ?? 'https://marlohealth.com.au';
const canonical = new URL(Astro.url.pathname, site);
const imageUrl = image ? new URL(image, site).href : undefined;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Turn on the hidden starting state for entrances before first paint, so
         nothing flashes and then animates. If the motion script hasn't loaded
         within 3s, drop it again so the page is never left hidden. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('js-motion');
        setTimeout(function () {
          if (!d.classList.contains('js-ready')) d.classList.remove('js-motion');
        }, 3000);
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Marlo" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="en_AU" />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {
      article?.modified && (
        <meta property="article:modified_time" content={article.modified.toISOString()} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#750D32" />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/favicon.svg')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Karla:wght@400..700&display=swap"
    />

    <!-- Aloevera, licensed from Salamahtype. The brand display face. -->
    <style
      is:inline
      set:html={`@font-face{font-family:'Aloevera';src:url('${withBase('/fonts/Aloevera-Regular.ttf')}') format('truetype');font-weight:400;font-style:normal;font-display:swap}`}
    />

    <slot name="head" />
  </head>

  <body>
    {!bare && <Nav />}
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
