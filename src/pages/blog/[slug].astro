---
import { render } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { withBase } from '../../site';
import { getPosts, formatDate, readingMinutes, type Post } from '../../lib/blog';

/*
 * One blog post. The words come from a Markdown file in src/content/blog;
 * this page adds the headline, byline, cover, a list of what's on the page,
 * the sources and the standing "general information" note.
 *
 * No entrance animations here on purpose. People arrive from search to read,
 * so the words are there straight away.
 */

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

interface Props {
  post: Post;
  posts: Post[];
}

const { post, posts } = Astro.props;
const { title, description, pubDate, updatedDate, author, reviewedBy, cover, coverAlt, sources } =
  post.data;

const { Content, headings } = await render(post);
const contents = headings.filter((h) => h.depth === 2);
const minutes = readingMinutes(post.body);
const more = posts.filter((p) => p.id !== post.id).slice(0, 3);

// Link previews want a plain PNG at 1200 wide.
const share = await getImage({
  src: post.data.shareImage ?? cover,
  width: 1200,
  format: 'png',
});

const site = Astro.site ?? new URL('https://marlohealth.com.au');
const url = new URL(Astro.url.pathname, site).href;
const blogUrl = new URL(withBase('/blog/'), site).href;
const teamUrl = new URL(withBase('/team'), site).href;
const day = (d: Date) => d.toISOString().slice(0, 10);

const structured = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: title,
      description,
      image: [new URL(share.src, site).href],
      datePublished: pubDate.toISOString(),
      dateModified: (updatedDate ?? pubDate).toISOString(),
      inLanguage: 'en-AU',
      mainEntityOfPage: url,
      author: {
        '@type': 'Person',
        name: author.name,
        ...(author.role && { jobTitle: author.role }),
        worksFor: { '@type': 'Organization', name: 'Marlo' },
        url: teamUrl,
      },
      publisher: {
        '@type': 'Organization',
        name: 'Marlo',
        url: new URL(withBase('/'), site).href,
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Marlo', item: new URL(withBase('/'), site).href },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: blogUrl },
        { '@type': 'ListItem', position: 3, name: title },
      ],
    },
  ],
};
---

<Base
  title={title}
  description={description}
  image={share.src}
  imageAlt={title}
  article={{ published: pubDate, modified: updatedDate }}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(structured)} />

  <article class="post">
    <header class="page post-head">
      <div class="post-col">
        <h1 class="h1 post-title">{title}</h1>
        <p class="post-meta">
          <span>By <a href={withBase('/team')}>{author.name}</a></span>
          <span><time datetime={day(pubDate)}>{formatDate(pubDate)}</time></span>
          {
            updatedDate && (
              <span>
                Updated <time datetime={day(updatedDate)}>{formatDate(updatedDate)}</time>
              </span>
            )
          }
          <span>{minutes} minute read</span>
        </p>
        {
          reviewedBy && (
            <p class="post-meta">
              <span>
                Checked by {reviewedBy.name}, {reviewedBy.role}, on{' '}
                <time datetime={day(reviewedBy.date)}>{formatDate(reviewedBy.date)}</time>
              </span>
            </p>
          )
        }
      </div>

      <Image
        class="post-cover"
        src={cover}
        alt={coverAlt}
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 70rem) 60rem, 92vw"
        loading="eager"
        fetchpriority="high"
      />
    </header>

    <div class="page">
      <div class="post-col">
        {
          contents.length > 2 && (
            <nav class="post-contents" aria-labelledby="on-this-page">
              <h2 id="on-this-page" class="h4">On this page</h2>
              <ol>
                {contents.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        <div class="prose">
          <Content />
        </div>

        {
          sources.length > 0 && (
            <section class="post-sources" aria-labelledby="sources">
              <h2 id="sources" class="h4">Where this comes from</h2>
              <ul>
                {sources.map((s) => (
                  <li>
                    <a href={s.url}>{s.title}</a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <p class="post-note">
          This article is general information. It isn’t medical advice, and it can’t tell you
          what’s going on with your own health. If something is worrying you, see your GP or call
          healthdirect on <strong>1800 022 222</strong>. In an emergency, call <strong>000</strong>.
        </p>
      </div>
    </div>
  </article>

  <section class="page post-more">
    {
      more.length > 0 && (
        <>
          <h2 class="h2 post-more-title">Keep reading</h2>
          <ul class="post-more-grid">
            {more.map((p) => (
              <li>
                <PostCard post={p} level="h3" />
              </li>
            ))}
          </ul>
        </>
      )
    }
    <p class="post-back">
      <a href={withBase('/blog/')} class="btn btn-secondary">Back to the blog</a>
    </p>
  </section>
</Base>

<style>
  .post {
    padding-top: clamp(7.5rem, 5rem + 7vw, 11rem);
  }

  .post-col {
    max-width: 44rem;
    margin-inline: auto;
  }

  .post-title {
    font-size: clamp(2.2rem, 1.3rem + 3.4vw, 3.9rem);
    line-height: 1.02;
  }

  /* Byline: short facts in a row, a clay dot between each. Every fact carries
     a dot in its left padding, and the strip holding the first dot of each
     line is clipped away, so a line never starts with one. */
  .post-meta {
    --dot-gap: 1.4rem;
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.35rem;
    margin-top: 1.5rem;
    margin-left: calc(var(--dot-gap) * -1);
    clip-path: inset(0 0 0 var(--dot-gap));
    font-size: var(--t-small);
    color: var(--ink-muted);
  }

  .post-meta + .post-meta {
    margin-top: 0.5rem;
  }

  .post-meta span {
    position: relative;
    padding-left: var(--dot-gap);
  }

  .post-meta span::before {
    content: '';
    position: absolute;
    left: calc(var(--dot-gap) / 2 - 0.15rem);
    top: 0.62em;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .post-cover {
    display: block;
    width: 100%;
    max-width: 60rem;
    height: auto;
    margin: clamp(2rem, 1.25rem + 3vw, 3.5rem) auto 0;
    border-radius: var(--r-panel);
  }

  /* ════════════════════════════════════════════════════ on this page */
  .post-contents {
    margin-top: clamp(2rem, 1.25rem + 3vw, 3.5rem);
    padding: clamp(1.5rem, 1rem + 1.5vw, 2rem);
    background: var(--paper);
    border-radius: var(--r-lg);
  }

  .post-contents ol {
    list-style: none;
    padding: 0;
    margin-top: 0.9rem;
    display: grid;
    gap: 0.5rem;
  }

  /* ═══════════════════════════════════════════════════════ the words
   * Markdown comes in without our class names, so these reach in. */
  .prose {
    margin-top: clamp(2rem, 1.25rem + 3vw, 3.5rem);
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .prose :global(> * + *) {
    margin-top: 1.15em;
  }

  .prose :global(h2),
  .prose :global(h3) {
    text-wrap: balance;
  }

  .prose :global(h2) {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(1.65rem, 1.3rem + 1.4vw, 2.3rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin-top: 2.2em;
  }

  .prose :global(h3) {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    margin-top: 1.9em;
  }

  .prose :global(h2 + *),
  .prose :global(h3 + *) {
    margin-top: 0.7em;
  }

  .prose :global(a),
  .post-contents a,
  .post-sources a,
  .post-meta a {
    text-decoration-color: var(--line-strong);
  }

  .prose :global(a:hover),
  .post-contents a:hover,
  .post-sources a:hover,
  .post-meta a:hover {
    text-decoration-color: currentColor;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 0;
    display: grid;
    gap: 0.6em;
  }

  .prose :global(ul) {
    list-style: none;
  }

  .prose :global(ul > li) {
    position: relative;
    padding-left: 1.5rem;
  }

  .prose :global(ul > li::before) {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 0.68em;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .prose :global(ol) {
    list-style: none;
    counter-reset: step;
  }

  .prose :global(ol > li) {
    position: relative;
    padding-left: 2.6rem;
    counter-increment: step;
  }

  .prose :global(ol > li::before) {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0.08em;
    width: 1.75rem;
    height: 1.75rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--blush);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1;
  }

  /* Something to copy, like a message to send. */
  .prose :global(blockquote) {
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    background: var(--paper);
    border-radius: var(--r-lg);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .prose :global(blockquote > * + *) {
    margin-top: 0.9em;
  }

  .prose :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--r-lg);
    margin-top: 1.75em;
  }

  /* Wide tables scroll sideways inside the column, not the page. */
  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--t-small);
    line-height: 1.5;
  }

  .prose :global(th),
  .prose :global(td) {
    min-width: 8rem;
    padding: 0.75rem 1rem 0.75rem 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }

  .prose :global(th) {
    border-bottom-color: var(--line-strong);
  }

  /* A closing line in italics is the small print for that post. */
  .prose :global(> p:last-child > em:only-child) {
    display: block;
    font-size: var(--t-small);
    line-height: 1.6;
    color: var(--ink-muted);
  }

  /* ═════════════════════════════════════════════ sources and the note */
  .post-sources {
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    padding-top: clamp(1.5rem, 1rem + 1.5vw, 2rem);
    border-top: 1px solid var(--line);
  }

  .post-sources ul {
    list-style: none;
    padding: 0;
    margin-top: 0.9rem;
    display: grid;
    gap: 0.5rem;
    font-size: var(--t-small);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .post-note {
    margin-top: clamp(2rem, 1.25rem + 2vw, 3rem);
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    background: var(--sky);
    border-radius: var(--r-lg);
    font-size: var(--t-small);
    line-height: 1.6;
  }

  /* ════════════════════════════════════════════════════ keep reading */
  .post-more {
    padding-block: clamp(3.5rem, 2rem + 5vw, 6.5rem);
  }

  .post-more-title {
    text-align: center;
  }

  .post-more-grid {
    list-style: none;
    padding: 0;
    margin-top: clamp(1.75rem, 1rem + 2vw, 3rem);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(1rem, 0.5rem + 1.2vw, 1.5rem);
  }

  .post-more-grid li {
    flex: 1 1 18rem;
    max-width: 26rem;
  }

  .post-back {
    text-align: center;
  }

  .post-more-grid + .post-back {
    margin-top: clamp(2rem, 1.25rem + 2vw, 3rem);
  }
</style>
